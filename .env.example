[TEMPLATE]
# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Dipakai server untuk operasi tulis (publish/update/hapus + upload lampiran)
SUPABASE_SERVICE_KEY=your-service-role-key

# Google Gemini API (news curation + chat assistant)
GEMINI_API_KEY=your-gemini-api-key

# Admin (for /admin panel)
ADMIN_PASSWORD=your-secure-password

# Cron auth — Vercel Cron mengirim "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=your-random-secret

# Form kontak — isi salah satu
# 1) kirim via Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=faber.aritonang@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# 2) atau teruskan ke webhook (Zapier/Make/Discord/Slack)
CONTACT_WEBHOOK_URL=
